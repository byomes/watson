.env
data/watson.db
data/archive/
data/qr/
data/chroma/
data/congregation.db
data/donors.db
data/curator.db
data/trading.db
__pycache__/
*.pyc
.claude/settings.local.json

# Runtime logs
logs/

# ARC password recovery reports — plaintext credentials, never commit
# (already covered by logs/ above; explicit rule kept in case that changes)
arc_password_recovery_*.txt
data/*.log
data/reading_list.json
data/riddle_current.json
data/retreats_seen.json

# Transcripts (generated at runtime)


# Python environment
venv/

# Editor/OS artifacts
.env~
config/settings.py.save
udo journalctl -u watson-bot.service -n 50

# Local env overrides (never commit secrets)
.env.local
.env.backup-*
*.db.backup-*

# Google OAuth credentials (keep on server only)
client_secret_*.json
config/credentials.json
config/token.json
config/sheets_service_account.json
*.csv
import_connect_cards.py
*.deb
briefing/templates/briefing.html
briefing/templates/briefing.html
docs/briefing.html
*.db.bak-*

# Secrets audit staging file — variable names/purposes only, never committed
memory/secrets_audit_draft.md

# Audiobook mastering pipeline — raw/processed audio and reports, not code
jobs/audiobook/input/*
jobs/audiobook/processed/*
jobs/audiobook/samples/*
jobs/audiobook/reports/*
!jobs/audiobook/input/.gitkeep
!jobs/audiobook/processed/.gitkeep
!jobs/audiobook/samples/.gitkeep
!jobs/audiobook/reports/.gitkeep
